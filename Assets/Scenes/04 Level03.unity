  m_Script: {fileID: 11500000, guid: 0cdb00cc2b2d9458989357b0754c75ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueContainer: {fileID: 1731933515}
  characterImage: {fileID: 807421780}
  dialogueText: {fileID: 613827021}
  nextButton: {fileID: 953822989}
  characterSprites:
  - {fileID: 3700738376484193928, guid: fa94a8c13566fa9498c65ac1301fd1b7, type: 3}
  - {fileID: 7605529789493939797, guid: 66cd1ec49c58be24d818342e98b227c2, type: 3}
  - {fileID: 21300000, guid: 2ca88a89899d81c4d87d0a2aa225770d, type: 3}
  dialogueLines:
  - "\xA1Oh! Se ha escapado otro esclavo... escoria in\xFAtil."
  - " \xBFA qui\xE9n llamas esclavo? Porque no pareces exactamente la imagen de la
    libertad, con todo ese mal humor."
  - "\xA1Qu\xE9 insolente! \xBFC\xF3mo te atreves a dirigirme la palabra, basura?"
  - "Bueno, t\xE9cnicamente no solo te estoy dirigiendo la palabra\u2026 tambi\xE9n
    te estoy robando tu momento de villano. \xBFTe est\xE1 molestando?"
  - " \xA1Guardias! \xA1Usen la mata de poder y liquiden a este asqueroso esclavo!"
  - "\xA1S\xED, se\xF1or!"
  - (Sonriendo mientras se prepara) Oh, genial, porque necesitaba calentar. Venid,
    que los espero.
  characterIndices: 00000000010000000000000001000000000000000200000001000000
